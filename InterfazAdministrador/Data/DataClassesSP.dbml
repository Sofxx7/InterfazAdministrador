      <Column Name="idEvento" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="nombreEvento" Type="System.String" DbType="VarChar(20)" CanBeNull="true" />
      <Column Name="idFecha1" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
